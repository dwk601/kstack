{
  "models": {
    "deep": {
      "cli": "codex",
      "model": "CODEX_MODEL_ID",
      "effort": "high"
    },
    "critic": {
      "cli": "pi",
      "model": "PROVIDER/CRITIC_MODEL_ID",
      "effort": "high"
    },
    "builder": {
      "cli": "pi",
      "model": "PROVIDER/WORKER_MODEL_ID",
      "effort": "high"
    },
    "checker": {
      "cli": "pi",
      "model": "PROVIDER/REVIEWER_MODEL_ID",
      "effort": "high"
    }
  },
  "roles": {
    "planner": "deep",
    "plan_critic": "critic",
    "workers": [
      "builder"
    ],
    "reviewer": "checker",
    "verifiers": [
      "critic",
      "checker"
    ],
    "fixer": "builder"
  },
  "execution": {
