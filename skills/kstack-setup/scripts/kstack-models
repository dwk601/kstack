#!/usr/bin/env python3
"""Resolve kstack roles to agent commands. Stdlib only, Python 3.8+.

  kstack-models show
  kstack-models validate [--check]
  kstack-models cmd ROLE [--index N] [--herdr NAME --pane ID | --oneshot]
"""
import argparse
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
from pathlib import Path

ROLES = ("planner", "plan_critic", "workers", "reviewer",
         "security_reviewer", "verifiers", "fixer")
CLIS = ("pi", "codex")
PI_EFFORTS = ("off", "minimal", "low", "medium", "high", "xhigh", "max")
PI_LIST_TIMEOUT = 30  # seconds; `pi --list-models` must not hang validate --check


def config_path():
    if os.environ.get("KSTACK_CONFIG"):
        return Path(os.environ["KSTACK_CONFIG"]).expanduser()
    base = os.environ.get("XDG_CONFIG_HOME") or str(Path.home() / ".config")
    return Path(base) / "kstack" / "config.json"


def load():
    path = config_path()
    try:
        cfg = json.loads(path.read_text())
    except FileNotFoundError:
        sys.exit("kstack: no config at %s. Run kstack-setup." % path)
    except json.JSONDecodeError as e:
        sys.exit("kstack: invalid JSON in %s: %s" % (path, e))
    if not isinstance(cfg, dict):
        sys.exit("kstack: invalid config %s\n  top level must be a JSON object" % path)
    return cfg


def section(cfg, key):
    """A top-level section as a dict; malformed sections read as empty (problems() reports them)."""
    value = cfg.get(key)
    return value if isinstance(value, dict) else {}


def preset_names(cfg, role):
    value = section(cfg, "roles").get(role)
    return value if isinstance(value, list) else ([value] if value else [])


def positive_int(value):
    return isinstance(value, int) and not isinstance(value, bool) and value >= 1


def argv(preset, oneshot=False):
    if preset["cli"] == "pi":
        args = ["pi"] + (["-p", "--no-session"] if oneshot else [])
        args += ["--model", "%s:%s" % (preset["model"], preset["effort"])]
    else:
        # Preset args go before `exec`: root-only options (for example --search, -a) fail after it.
        args = ["codex"] + list(preset.get("args", [])) + (["exec"] if oneshot else [])
        return args + ["-m", preset["model"], "-c", "model_reasoning_effort=%s" % preset["effort"]]
    return args + list(preset.get("args", []))


def problems(cfg):
    out = []
    for key in ("models", "roles", "execution", "finish"):
        if key in cfg and not isinstance(cfg[key], dict):
            out.append("%s: must be an object" % key)
    models = section(cfg, "models")
    for name, p in models.items():
        if not isinstance(p, dict):
            out.append("model %s: must be an object" % name)
            continue
        if p.get("cli") not in CLIS:
            out.append("model %s: cli must be one of %s" % (name, ", ".join(CLIS)))
        for key in ("model", "effort"):
            if not isinstance(p.get(key), str) or not p.get(key):
                out.append("model %s: missing %s" % (name, key))
        if p.get("cli") == "pi" and p.get("effort") and p.get("effort") not in PI_EFFORTS:
            out.append("model %s: effort must be one of %s" % (name, ", ".join(PI_EFFORTS)))
        args = p.get("args", [])
        if not isinstance(args, list) or not all(isinstance(x, str) for x in args):
            out.append("model %s: args must be a list of strings" % name)
    for role in ROLES:
        names = preset_names(cfg, role)
        if not all(isinstance(n, str) for n in names):
            out.append("role %s: must be a preset name or a list of preset names" % role)
            continue
        if not names:
            out.append("role %s: not set" % role)
        out += ["role %s: unknown model '%s'" % (role, n) for n in names if n not in models]
    if not positive_int(section(cfg, "execution").get("max_fails")):
        out.append("execution.max_fails: must be a positive integer")
    finish = section(cfg, "finish")
    if finish.get("target", "pr-green") not in ("pr-green", "merged", "deployed"):
        out.append("finish.target: must be pr-green, merged, or deployed")
    if not positive_int(finish.get("max_fix_rounds")):
        out.append("finish.max_fix_rounds: must be a positive integer")
    for key in ("allow_merge", "allow_deploy"):
        if key in finish and not isinstance(finish[key], bool):
            out.append("finish.%s: must be true or false" % key)
    return out


def family(model_id):
    """Warning-only key so `openai/gpt-x` (pi) and `gpt-x` (codex) compare equal. Never used in argv."""
    return model_id.rsplit("/", 1)[-1].lower()


def warnings(cfg):
    models, out = cfg.get("models") or {}, []

    def ids(role):
        return {family(models[n]["model"]) for n in preset_names(cfg, role) if n in models}

    if ids("planner") & ids("plan_critic"):
        out.append("planner and plan_critic use the same model; the cross-check loses diversity")
    if ids("workers") & (ids("reviewer") | ids("verifiers")):
        out.append("a reviewer or verifier shares a model with a worker; prefer a different one")
    audit = [family(models[n]["model"]) for n in preset_names(cfg, "verifiers")[:2] if n in models]
    if len(set(audit)) < 2:
        out.append("the two audit lanes run on one model; list two different verifiers first")
    return out


def pi_catalog():
    """Model ids from `pi --list-models`, or (None, reason) when the listing itself is unusable."""
    env = dict(os.environ, PI_OFFLINE="1")
    try:
        res = subprocess.run(["pi", "--list-models"], capture_output=True, text=True,
                             env=env, timeout=PI_LIST_TIMEOUT)
    except subprocess.TimeoutExpired:
        return None, "`pi --list-models` timed out after %ss" % PI_LIST_TIMEOUT
    except OSError as e:
        return None, "`pi --list-models` could not run (%s)" % e
    if res.returncode != 0:
        detail = (res.stderr or "").strip().splitlines()
        return None, "`pi --list-models` exited %d%s" % (res.returncode, ": " + detail[-1] if detail else "")
    ids = {"/".join(line.split()[:2]) for line in res.stdout.splitlines() if len(line.split()) >= 2}
    ids.discard("provider/model")  # header row
    if not ids:
        return None, "`pi --list-models` listed no models"
    return ids, None


def codex_catalog():
    """Codex slug -> supported efforts, or (None, reason) when no readable catalog exists."""
    toml = Path(os.environ.get("CODEX_HOME", str(Path.home() / ".codex"))) / "config.toml"
    try:
        match = re.search(r'^model_catalog_json\s*=\s*"([^"]+)"', toml.read_text(), re.M) if toml.exists() else None
        if not match or not Path(match.group(1)).expanduser().exists():
            return None, "no Codex model catalog found"
        catalog = json.loads(Path(match.group(1)).expanduser().read_text())
        return {m["slug"]: {e["effort"] for e in m.get("supported_reasoning_levels", [])}
                for m in catalog.get("models", [])}, None
    except (OSError, ValueError, KeyError, TypeError, AttributeError) as e:
        return None, "Codex model catalog unreadable (%s: %s)" % (type(e).__name__, e)


def availability(cfg):
    """Check presets against local catalogs. Catalog presence is not proof of access.

    Returns (errors, notes): errors are presets missing from a working catalog; notes cover
    presets left unchecked because a catalog was unavailable. An unavailable catalog never
    marks a preset invalid.
    """
    out, notes = [], []
    presets = (cfg.get("models") or {}).items()
    clis = {p.get("cli") for _, p in presets}
    pi_ids = codex = None
    if "pi" in clis:
        pi_ids, why = pi_catalog() if shutil.which("pi") else (None, "pi not installed")
        if pi_ids is None:
            notes.append("%s; pi presets not checked" % why)
    if "codex" in clis:
        codex, why = codex_catalog()
        if codex is None:
            notes.append("%s; codex presets not checked" % why)
    for name, p in presets:
        if p.get("cli") == "pi" and pi_ids is not None:
            if p["model"] not in pi_ids:
                out.append("model %s: %s not in `pi --list-models`" % (name, p["model"]))
        elif p.get("cli") == "codex" and codex is not None:
            if p["model"] not in codex:
                out.append("model %s: %s not in the Codex catalog" % (name, p["model"]))
            elif codex[p["model"]] and p["effort"] not in codex[p["model"]]:
                out.append("model %s: effort %s not supported by %s" % (name, p["effort"], p["model"]))
    return out, notes


def main():
    ap = argparse.ArgumentParser(prog="kstack-models")
    sub = ap.add_subparsers(dest="action", required=True)
    sub.add_parser("show")
    v = sub.add_parser("validate")
    v.add_argument("--check", action="store_true", help="also check local model catalogs")
    c = sub.add_parser("cmd")
    c.add_argument("role", choices=ROLES)
    c.add_argument("--index", type=int, default=0, help="task number; rotates the workers pool")
    c.add_argument("--herdr", metavar="NAME", help="print a herdr agent start command")
    c.add_argument("--pane", help="herdr pane id (with --herdr)")
    c.add_argument("--oneshot", action="store_true",
                   help="non-interactive form (pi -p / codex exec); append the brief as the last argument")
    a = ap.parse_args()
    cfg = load()

    if a.action == "show":
        print("config: %s" % config_path())
        models = section(cfg, "models")
        for role in ROLES:
            for n in preset_names(cfg, role):
                p = models.get(n) if isinstance(n, str) else None
                p = p if isinstance(p, dict) else {}
                print("%-21s %-18s %-6s %s:%s" % (role, n, p.get("cli"), p.get("model"), p.get("effort")))
        print("execution: %s" % json.dumps(cfg.get("execution", {})))
        print("finish: %s" % json.dumps(cfg.get("finish", {})))
        return 0

    errs = problems(cfg)
    if errs:
        sys.exit("kstack: invalid config %s\n  %s" % (config_path(), "\n  ".join(errs)))

    if a.action == "validate":
        bad, notes = availability(cfg) if a.check else ([], [])
        for n in warnings(cfg) + notes:
            print("warning: %s" % n)
        if bad:
            sys.exit("kstack: unusable models in %s\n  %s" % (config_path(), "\n  ".join(bad)))
        print("ok: %s" % config_path())
        return 0

    names = preset_names(cfg, a.role)
    args = argv(cfg["models"][names[a.index % len(names)]], a.oneshot)
    if a.herdr:
        if not a.pane or a.oneshot:
            sys.exit("kstack: --herdr needs --pane and cannot be combined with --oneshot")
        args = ["herdr", "agent", "start", a.herdr, "--kind", args[0], "--pane", a.pane, "--"] + args[1:]
    print(" ".join(shlex.quote(x) for x in args))
    return 0


if __name__ == "__main__":
    sys.exit(main())
